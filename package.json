{
  "name": "voice-premium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Waly Robert",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "diagnostico": "node scripts/doctor.mjs",
    "iniciar": "node scripts/start.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.556.0"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "tailwindcss": "3.4.19",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21",
    "vitest": "3.2.7",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.2"
  }
}
